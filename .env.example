# Copy to .env.local and fill in.

# ---- WordPress REST API -------------------------------------------------
# Both values are shown in WordPress under:
#   Brandsquare -> Dashboard Access
#
# The dashboard never connects to MySQL. It reaches WordPress over HTTPS, so
# the database stays bound to 127.0.0.1 with nothing exposed to the internet.
WP_API_URL=https://brandsquare.shop/wp-json/bsq/v1
WP_API_KEY=

# ---- App ----------------------------------------------------------------
# Public URL of THIS dashboard. Used to build invite links in emails.
APP_URL=http://localhost:3000

# ---- Outbound email (invites) -------------------------------------------
# Leave SMTP_HOST empty during development: invite links are printed to the
# server console instead of being emailed, so you can still test the flow.
# Set it before creating any sub-admin, or their invite will never arrive.
#
# Gmail: SMTP_PASSWORD must be a 16-character App Password, not the account
# password. Requires 2-Step Verification, then myaccount.google.com/apppasswords
# Port 587 with SMTP_SECURE=false is STARTTLS — encrypted, despite the name.
#
# MAIL_FROM should use the same address as SMTP_USER. Gmail rewrites a From
# header it hasn't verified, so a different address there simply won't stick
# unless you add it under Gmail Settings -> Accounts -> Send mail as.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=brandsquarebackend@gmail.com
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Brandsquare <brandsquarebackend@gmail.com>"
